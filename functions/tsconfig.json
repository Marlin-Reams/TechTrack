{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./lib",

    "strict": true,

    "esModuleInterop": true,

    "sourceMap": true,

    "noImplicitReturns": true,
    "noUnusedLocals": true
  },

  "compileOnSave": true,

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "lib",
    "node_modules"
  ]
}